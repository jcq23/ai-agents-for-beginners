# Brisbane Development Site Finder - Environment Configuration

# ===== AI Service Configuration =====
# Choose one: OpenAI or Azure OpenAI

# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Option 2: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ===== Email Alert Configuration (Optional) =====
# For sending email alerts when new development sites are found
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@dev-site-finder.com

# ===== API Integrations (Future) =====
# These would be used in production to access real data sources
# BRISBANE_COUNCIL_API_KEY=your-api-key
# DOMAIN_API_KEY=your-domain-api-key
# REA_API_KEY=your-realestate-api-key
# CORELOGIC_API_KEY=your-corelogic-api-key
